TELEGRAM_TOKEN=8435011223:AAEeZRiQXJCiNWS6PusvxA1ZCF6uBwIG0uc
SERVER_IP=
# Set to 'false' for headed mode (laptop with GUI), 'true' or omit for headless (VPS/server)
HEADLESS=true

# Polling configuration for the OID monitor
# Set a lower value to poll faster; use higher values if you want less traffic.
# POLL_INTERVAL_MS=2000
# MAX_POLL_DURATION_MS=1800000
# API_CAPTURE_MAX_RETRIES=30
# API_CAPTURE_RETRY_DELAY_MS=5000

# Proxy Configuration
# Set USE_PROXIES=true only if you have working proxies and want the bot to use them.
USE_PROXIES=true
PROXIES_FILE=./proxies.txt

# Configure up to 20 proxies when USE_PROXIES=true
# Each proxy must have host and port.
# Optional: add username/password if your proxy needs authentication.
# PROXY_1_HOST=proxy1.example.com
# PROXY_1_PORT=8080
# PROXY_1_USERNAME=username
# PROXY_1_PASSWORD=password
# PROXY_1_TYPE=http
# PROXY_2_HOST=proxy2.example.com
# PROXY_2_PORT=8080
# PROXY_2_TYPE=socks5
# ... up to PROXY_20_*

# Allow scheduling for past dates (for testing)
ALLOW_PAST_SCHEDULES=false